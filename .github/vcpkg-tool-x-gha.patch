diff --git i/github-actions-cache-adapter/main.mjs w/github-actions-cache-adapter/main.mjs
new file mode 100644
index 00000000..8ef40ebb
--- /dev/null
+++ w/github-actions-cache-adapter/main.mjs
@@ -0,0 +1,100 @@
+// Copyright (c) Microsoft Corporation.
+// Licensed under the MIT License.
+
+// Connects vcpkg's x-gha binary source to the GitHub Actions cache. GitHub supports only @actions/cache as a
+// client for that service, so vcpkg runs this script instead of calling the service itself.
+//
+// vcpkg writes one request to stdin:
+//   {"operation": "restore" | "save", "directory": "<absolute path>", "entries": [{"key": "...", "path": "..."}]}
+//
+// Each path is a file name relative to directory. @actions/cache hashes the paths it is given into the cache
+// version, so passing relative paths lets machines that keep vcpkg in different places share entries.
+//
+// restore: downloads every entry that exists into directory; vcpkg checks which files arrived. Misses are not
+//          errors, but exits with a nonzero code if a lookup or download failed.
+// save: uploads every entry. Exits with a nonzero code if any of them is not in the cache afterwards.
+//
+// @actions/cache logs to stdout, which vcpkg shows only with --debug or when this script fails.
+
+import * as cache from '@actions/cache';
+import { text } from 'node:stream/consumers';
+
+const RESTORE_CONCURRENCY = 8;
+
+async function forEachLimited(items, limit, work) {
+  let next = 0;
+  const workers = Array.from({ length: Math.min(limit, items.length) }, async () => {
+    while (next < items.length) {
+      await work(items[next++]);
+    }
+  });
+  await Promise.all(workers);
+}
+
+const request = JSON.parse(await text(process.stdin));
+const { operation, directory, entries } = request;
+if (typeof directory !== 'string' || !Array.isArray(entries)) {
+  console.error('error: the request needs a directory and an array of entries');
+  process.exit(2);
+}
+
+// The runner sets ACTIONS_CACHE_SERVICE_V2 only for JavaScript actions, and the step that exposes the other
+// variables to run steps may not forward it. github.com no longer serves the v1 protocol, so pick v2 whenever its
+// URL is present. On GitHub Enterprise Server, @actions/cache uses v1 regardless.
+if (process.env.ACTIONS_RESULTS_URL && !process.env.ACTIONS_CACHE_SERVICE_V2) {
+  process.env.ACTIONS_CACHE_SERVICE_V2 = 'true';
+}
+
+// @actions/cache stores and extracts paths relative to GITHUB_WORKSPACE.
+process.chdir(directory);
+process.env.GITHUB_WORKSPACE = directory;
+
+let failures = 0;
+switch (operation) {
+  case 'restore': {
+    // restoreCache() returns the same thing for a miss and for a failed request, and reports failures only as
+    // workflow commands on stdout, so count those to keep a broken setup from looking like an empty cache.
+    const writeStdout = process.stdout.write.bind(process.stdout);
+    process.stdout.write = (chunk, ...rest) => {
+      if (/^::(warning|error)::/m.test(String(chunk))) {
+        ++failures;
+      }
+      return writeStdout(chunk, ...rest);
+    };
+
+    await forEachLimited(entries, RESTORE_CONCURRENCY, async ({ key, path }) => {
+      try {
+        await cache.restoreCache([path], key);
+      } catch (error) {
+        console.error(`warning: failed to restore ${key}: ${error.message}`);
+        ++failures;
+      }
+    });
+    break;
+  }
+  case 'save':
+    for (const { key, path } of entries) {
+      try {
+        if ((await cache.saveCache([path], key)) !== -1) {
+          continue;
+        }
+
+        // Jobs that build the same package at the same time race to save it, and the loser cannot store an entry
+        // that already exists.
+        if ((await cache.restoreCache([path], key, [], { lookupOnly: true })) === key) {
+          console.log(`${key} is already stored`);
+          continue;
+        }
+      } catch (error) {
+        console.error(`warning: failed to save ${key}: ${error.message}`);
+      }
+
+      ++failures;
+    }
+    break;
+  default:
+    console.error(`error: unknown operation '${operation}'`);
+    process.exit(2);
+}
+
+process.exit(failures === 0 ? 0 : 1);
