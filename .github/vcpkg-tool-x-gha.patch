+    // creates the archive to push as package_dir + ".zip", which yields the same name.
+    std::string make_gha_archive_name(const Path& package_dir)
+    {
+        return Strings::concat(package_dir.filename(), ".zip");
+    }
+
+    struct GhaBinaryProvider : ZipReadBinaryProvider
+    {
+        GhaBinaryProvider(const ZipTool& zip, const Path& buildtrees, std::shared_ptr<const GhaCacheAdapter> adapter)
+            : ZipReadBinaryProvider(zip), m_buildtrees(buildtrees), m_adapter(std::move(adapter))
+        {
+        }
+
+        void acquire_zips(DiagnosticContext& context,
+                          const Filesystem& fs,
+                          View<const InstallPlanAction*> actions,
+                          Span<Optional<ZipResource>> out_zip_paths) const override
+        {
+            WarningDiagnosticContext wdc{context};
+            const auto directory = m_buildtrees / ".gha";
+            // The adapter reports hits by leaving archives here, so archives from an earlier run must not remain.
+            if (!fs.remove_all(wdc, directory) || !fs.create_directories(wdc, directory))
+            {
+                return;
+            }
+
+            std::vector<std::pair<std::string, std::string>> entries;
+            entries.reserve(actions.size());
+            for (auto&& action : actions)
