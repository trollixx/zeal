+                entries.emplace_back(make_gha_cache_key(action->spec, action->package_abi_or_exit(VCPKG_LINE_INFO)),
+                                     make_gha_archive_name(action->package_dir));
+            }
+
+            // A failure for some entries still leaves the others usable.
+            (void)m_adapter->run(wdc, "restore", directory, entries);
+            for (size_t idx = 0; idx < actions.size(); ++idx)
